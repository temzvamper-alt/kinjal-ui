local Roblox = game
local Services = {}
local UI = {}
local Windows = {}

local function getService(serviceName)
	-- Безопасно получает сервис Roblox для текущего UI-модуля.
	local ok, service = pcall(function()
		return Roblox:GetService(serviceName)
	end)

	if ok then
		return service
	end

	return nil
end

Services.Players = getService("Players")
Services.TweenService = getService("TweenService")
Services.UserInputService = getService("UserInputService")
Services.GuiService = getService("GuiService")
Services.RunService = getService("RunService")

local Runtime
local Config
local moduleParent

pcall(function()
	moduleParent = script.Parent
end)

if moduleParent then
	pcall(function()
		Runtime = require(moduleParent:WaitForChild("runtime"))
	end)

	pcall(function()
		Config = require(moduleParent:WaitForChild("config"))
	end)
end

if not Runtime then
	Runtime = {
		GetLocalPlayer = function()
			-- Возвращает локального игрока в резервном режиме библиотеки.
			return Services.Players and Services.Players.LocalPlayer or nil
		end,
		GetPlatform = function()
			-- Возвращает резервное имя платформы.
			return "Unknown"
		end,
		SafeCall = function(callback)
			-- Выполняет callback через pcall в резервном режиме.
			return pcall(callback)
		end,
	}
end

if not Config then
	Config = {
		Get = function(_, fallback)
			-- Возвращает fallback, если библиотека загружена без config.lua.
			return fallback
		end,
	}
end

--================================================================================
-- [002] ЦВЕТА И ПАРАМЕТРЫ
--================================================================================

local function setting(path, fallback)
	-- Читает настройку через config.lua и возвращает fallback при ошибке.
	local ok, value = pcall(function()
		return Config.Get(path, fallback)
	end)

	if ok and value ~= nil then
		return value
	end

	return fallback
end

local function themeColor(name, fallback)
	-- Читает цвет текущей темы интерфейса.
	return setting("Theme." .. name, fallback)
end

