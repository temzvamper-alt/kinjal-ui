		BorderSizePixel = 0,
	}, content)
	window.StatsPanel = statsPanel
	addCorner(statsPanel, 8)
	addStroke(statsPanel, Colors.Outline, 1)

	local statsLabel = createTextLabel(statsPanel, "Session: 00:00  •  Objects: 0  •  Ready", 11, Colors.MutedText)
	statsLabel.Position = UDim2.new(0, 10, 0, 0)
	statsLabel.Size = UDim2.new(1, -20, 1, 0)
	statsLabel.TextXAlignment = Enum.TextXAlignment.Center
	window.StatsLabel = statsLabel

	local tabContent = create("Frame", {
		Name = "TabContent",
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
	}, content)
	window.TabContent = tabContent

	local emptyState = createTextLabel(tabContent, "Выбери вкладку слева", 16, Colors.MutedText)
	emptyState.AnchorPoint = Vector2.new(0.5, 0.5)
	emptyState.Position = UDim2.fromScale(0.5, 0.45)
	emptyState.Size = UDim2.new(0.8, 0, 0, 36)
	emptyState.TextXAlignment = Enum.TextXAlignment.Center
	window.EmptyState = emptyState

	local function updateCanvas()
		-- Обновляет область прокрутки после добавления или скрытия вкладок.
		if not isAlive(scroll) then
			return
		end

		pcall(function()
			scroll.CanvasSize = UDim2.new(0, 0, 0, scroll.AbsoluteCanvasSize.Y)
		end)
	end

	local function setTabButtonState(tab, selected)
		-- Применяет активное или обычное состояние кнопки вкладки.
		if not tab or not isAlive(tab.Button) then
			return
		end

		local targetColor = selected and Colors.Primary or Colors.Panel
		local targetTextColor = selected and Colors.Text or Colors.MutedText
		tween(tab.Button, {
			BackgroundColor3 = targetColor,
			TextColor3 = targetTextColor,
		}, getAnimationTime())
	end

	function window:SelectTab(tabName)
		-- Переключает область контента на вкладку по имени.
		if self.Destroyed then
			return false
		end

		local selectedTab = self.Tabs[tabName]
		if not selectedTab then
			return false
		end

		for _, tab in ipairs(self.TabOrder) do
			local selected = tab == selectedTab
			setTabButtonState(tab, selected)

			if isAlive(tab.Page) then
				tab.Page.Visible = selected
			end
		end

		self.CurrentTab = selectedTab
		if isAlive(self.EmptyState) then
			self.EmptyState.Visible = false
		end
		self.Changed:Fire("Tab", tabName)
		return true
	end

	function window:AddTab(tabOptions)
		-- Создаёт вкладку и возвращает объект для добавления контролов.
		if self.Destroyed then
			return nil, "Окно уничтожено"
		end

		tabOptions = type(tabOptions) == "table" and tabOptions or {}
		local tabName = tostring(tabOptions.Name or ("Tab " .. tostring(#self.TabOrder + 1)))
		if self.Tabs[tabName] then
			return self.Tabs[tabName]
		end

		local button = createTextButton(scroll, tostring(tabOptions.Title or tabName), 12, Colors.MutedText)
		button.Name = "Tab_" .. tabName:gsub("%W", "_")
		button.Size = UDim2.new(1, 0, 0, 32)
		button.LayoutOrder = #self.TabOrder + 1
		button.TextTruncate = Enum.TextTruncate.AtEnd
		addCorner(button, 8)

		local page = create("ScrollingFrame", {
			Name = "Page_" .. tabName:gsub("%W", "_"),
			Size = UDim2.new(1, -22, 1, -12),
			Position = UDim2.new(0, 11, 0, 6),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Colors.Primary,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
		}, tabContent)
		addPadding(page, 4, 4, 4, 54)
		local pageLayout = addListLayout(page, 8, false)

		local tab = {
			Name = tabName,
			Title = tostring(tabOptions.Title or tabName),
			Icon = tostring(tabOptions.Icon or ""),
			Button = button,
			Page = page,
			Layout = pageLayout,
			Controls = {},
			Changed = createSignal(),
			Window = self,
		}

		self.Tabs[tabName] = tab
		table.insert(self.TabOrder, tab)

		connectSignal(button.Activated, function()
			-- Выбирает вкладку при клике мышью или касании.
			self:SelectTab(tabName)
		end, self.Connections)

		connectSignal(button.MouseEnter, function()
			-- Подсвечивает вкладку при наведении мыши.
			if self.CurrentTab ~= tab then
				tween(button, {BackgroundColor3 = Colors.PanelLight}, getAnimationTime())
			end
		end, self.Connections)

		connectSignal(button.MouseLeave, function()
			-- Возвращает обычный цвет после ухода мыши.
			if self.CurrentTab ~= tab then
				tween(button, {BackgroundColor3 = Colors.Panel}, getAnimationTime())
			end
		end, self.Connections)

		connectSignal(page:GetPropertyChangedSignal("AbsoluteCanvasSize"), function()
			-- Поддерживает корректную область прокрутки страницы.
			pcall(function()
				page.CanvasSize = UDim2.new(0, 0, 0, page.AbsoluteCanvasSize.Y)
			end)
		end, self.Connections)

		updateCanvas()

		if not self.CurrentTab then
			self:SelectTab(tabName)
		end

		return tab
	end

	function window:FilterTabs(query)
		-- Фильтрует вкладки по строке поиска.
		query = string.lower(tostring(query or ""))

		for _, tab in ipairs(self.TabOrder) do
			local searchable = string.lower(tab.Name .. " " .. tab.Title)
			local visible = query == "" or string.find(searchable, query, 1, true) ~= nil
			tab.Button.Visible = visible
		end

		updateCanvas()
	end

	connectSignal(search:GetPropertyChangedSignal("Text"), function()
		-- Фильтрует вкладки при изменении строки поиска.
		window:FilterTabs(search.Text)
	end, window.Connections)

	connectSignal(scrollUp.Activated, function()
		-- Прокручивает список вкладок вверх.
		scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.CanvasPosition.Y - 120))
	end, window.Connections)

	connectSignal(scrollDown.Activated, function()
		-- Прокручивает список вкладок вниз.
		scroll.CanvasPosition = Vector2.new(0, scroll.CanvasPosition.Y + 120)
	end, window.Connections)

	connectSignal(scroll.InputChanged, function(input)
		-- Обрабатывает колесо мыши для прокрутки вкладок.
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local delta = input.Position.Z
			scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.CanvasPosition.Y - delta * 48))
		end
	end, window.Connections)

	connectSignal(minimizeButton.Activated, function()
		-- Сворачивает и разворачивает тело окна.
		window:SetVisible(not window.Visible)
	end, window.Connections)

	connectSignal(closeButton.Activated, function()
		-- Уничтожает окно по нажатию кнопки закрытия.
		window:Destroy()
	end, window.Connections)

	local dragging = false
	local dragStart
	local startPosition

	connectSignal(topbar.InputBegan, function(input)
		-- Начинает перемещение окна мышью или touch.
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = root.Position
		end
	end, window.Connections)

	connectSignal(topbar.InputEnded, function(input)
		-- Завершает перемещение окна.
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end, window.Connections)

	connectSignal(Services.UserInputService and Services.UserInputService.InputChanged, function(input)
		-- Обновляет позицию окна при перемещении указателя.
		if not dragging or not dragStart or not startPosition then
			return
		end

		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseMovement and inputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end, window.Connections)

	function window:SetVisible(visible)
		-- Показывает или скрывает тело окна с плавной анимацией.
		if self.Destroyed then
			return false
		end

		self.Visible = visible == true
		if isAlive(self.Body) then
			self.Body.Visible = self.Visible
		end
		return self.Visible
	end

	function window:Toggle()
		-- Переключает видимость окна.
		return self:SetVisible(not self.Visible)
	end

	function window:SetScale(scale)
		-- Устанавливает масштаб интерфейса в диапазоне 50–150 процентов.
		if not isAlive(self.Scale) then
			return false
		end

		local value = tonumber(scale) or 1
		value = math.max(0.5, math.min(1.5, value))
		tween(self.Scale, {Scale = value}, getAnimationTime())
		self.Changed:Fire("Scale", value)
		return true, value
	end

	function window:SetCompact(compact)
		-- Переключает компактный режим сайдбара.
		if self.Destroyed or not isAlive(self.Sidebar) then
			return false
		end

		self.Compact = compact == true
		local width = self.Compact and DEFAULT_COMPACT_SIDEBAR_WIDTH or setting("UI.SidebarWidth", DEFAULT_SIDEBAR_WIDTH)
		tween(self.Sidebar, {Size = UDim2.new(0, width, 1, 0)}, getAnimationTime())
		tween(self.Content, {
			Position = UDim2.new(0, width, 0, 0),
			Size = UDim2.new(1, -width, 1, 0),
		}, getAnimationTime())

		if isAlive(self.Search) then
			self.Search.Visible = not self.Compact
		end

		return true
	end

	function window:UpdateStats(data)
		-- Обновляет нижнюю панель статистики окна.
		if not isAlive(self.StatsLabel) then
			return false
		end

		data = type(data) == "table" and data or {}
		local session = tostring(data.Session or "00:00")
		local objects = tostring(data.Objects or 0)
		local status = tostring(data.Status or "Ready")
		self.StatsLabel.Text = string.format("Session: %s  •  Objects: %s  •  %s", session, objects, status)
		return true
	end

	function window:AddNotification(message, kind, duration)
		-- Создаёт временное уведомление в правом нижнем углу окна.
		message = tostring(message or "")
		kind = tostring(kind or "Info")
		duration = tonumber(duration) or 3

		local color = Colors.Primary
		if kind == "Success" then
			color = Colors.Success
		elseif kind == "Warning" then
			color = Colors.Warning
		elseif kind == "Error" then
			color = Colors.Error
		end

		local notification = create("TextLabel", {
			Name = "Notification",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 360, 1, -58),
			Size = UDim2.new(0, 340, 0, 42),
			BackgroundColor3 = Colors.Panel,
			BorderSizePixel = 0,
			Text = message,
			TextColor3 = Colors.Text,
			TextSize = 13,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextWrapped = true,
		}, self.Content)

		if not notification then
			return nil
		end

		addCorner(notification, 9)
		addStroke(notification, color, 1.5)
		addPadding(notification, 12, 10, 0, 0)
		tween(notification, {Position = UDim2.new(1, -12, 1, -58)}, getAnimationTime())

		local delayFunction = task and task.delay
		if type(delayFunction) == "function" then
			delayFunction(duration, function()
				if isAlive(notification) then
					local animation = tween(notification, {
						Position = UDim2.new(1, 360, 1, -58),
						TextTransparency = 1,
					}, getAnimationTime())

					if animation then
						animation.Completed:Wait()
					end
					safeDestroy(notification)
				end
			end)
		end

		return notification
	end

	function window:Destroy()
		-- Отключает события, сигналы и уничтожает весь UI.
		if self.Destroyed then
			return false
		end

		self.Destroyed = true
		for index = #self.Connections, 1, -1 do
			local connection = self.Connections[index]
			pcall(function()
				connection:Disconnect()
			end)
			self.Connections[index] = nil
		end

		self.Changed:Destroy()
		for _, tab in ipairs(self.TabOrder) do
			tab.Changed:Destroy()
		end

		safeDestroy(self.Gui)
		for index = #Windows, 1, -1 do
			if Windows[index] == self then
				table.remove(Windows, index)
				break
			end
		end

		return true
	end

	table.insert(Windows, window)
	return window
end

