function UI.GetPlatformLayout()
	-- Возвращает параметры адаптивной раскладки для текущей платформы.
	local platform = "Unknown"
	pcall(function()
		platform = Runtime.GetPlatform()
	end)

	if platform == "Mobile" then
		return {
			Platform = platform,
			Width = 360,
			Height = 540,
			Scale = 0.8,
			Compact = true,
		}
	end

	if platform == "Tablet" then
		return {
			Platform = platform,
			Width = 620,
			Height = 500,
			Scale = 0.9,
			Compact = false,
		}
	end

	return {
		Platform = platform,
		Width = DEFAULT_WINDOW_WIDTH,
		Height = DEFAULT_WINDOW_HEIGHT,
		Scale = 1,
		Compact = false,
	}
end

function UI.CreateResponsiveWindow(options)
	-- Создаёт окно с размерами, адаптированными под платформу.
	options = type(options) == "table" and options or {}
	local layout = UI.GetPlatformLayout()
	local merged = {}

	for key, value in pairs(options) do
		merged[key] = value
	end

	if merged.Width == nil then
		merged.Width = layout.Width
	end
	if merged.Height == nil then
		merged.Height = layout.Height
	end
	if merged.Scale == nil then
		merged.Scale = layout.Scale
	end
	if merged.Compact == nil then
		merged.Compact = layout.Compact
	end

	return UI.CreateWindow(merged)
end

