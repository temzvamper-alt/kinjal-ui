function UI.GetWindow(name)
	-- Находит окно по имени.
	for _, window in ipairs(Windows) do
		if window.Name == name and not window.Destroyed then
			return window
		end
	end

	return nil
end

function UI.DestroyAll()
	-- Уничтожает все окна библиотеки и освобождает UI-ресурсы.
	for index = #Windows, 1, -1 do
