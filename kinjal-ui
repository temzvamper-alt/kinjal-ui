	local body = create("Frame", {
		Name = "Body",
		Position = UDim2.new(0, 0, 0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1,
	}, root)
	window.Body = body

	local sidebarWidth = window.Compact and DEFAULT_COMPACT_SIDEBAR_WIDTH or setting("UI.SidebarWidth", DEFAULT_SIDEBAR_WIDTH)
	local sidebar = create("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, sidebarWidth, 1, 0),
		BackgroundColor3 = Colors.Panel,
		BorderSizePixel = 0,
	}, body)
	window.Sidebar = sidebar
	addGradient(sidebar, Colors.Panel, Colors.Background, 90)
	addStroke(sidebar, Colors.Outline, 1)

	local search = create("TextBox", {
		Name = "Search",
		PlaceholderText = "Search tabs",
		Text = "",
		ClearTextOnFocus = false,
		Position = UDim2.new(0, 8, 0, 8),
		Size = UDim2.new(1, -16, 0, 32),
		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Colors.Text,
		PlaceholderColor3 = Colors.MutedText,
	}, sidebar)
	window.Search = search
	addCorner(search, 8)
	addStroke(search, Colors.Outline, 1)
	addPadding(search, 10, 8, 0, 0)

	local scroll = create("ScrollingFrame", {
		Name = "TabScroll",
		Position = UDim2.new(0, 7, 0, 48),
		Size = UDim2.new(1, -14, 1, -88),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Colors.Primary,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, sidebar)
	window.TabScroll = scroll
	addListLayout(scroll, 4, false)
	addPadding(scroll, 1, 1, 3, 3)

	local scrollUp = createTextButton(sidebar, "▲", 12, Colors.MutedText)
	scrollUp.Name = "ScrollUp"
	scrollUp.Position = UDim2.new(0, 8, 1, -35)
