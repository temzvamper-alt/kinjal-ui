--================================================================================
-- [003] УТИЛИТЫ ЭКЗЕМПЛЯРОВ
--================================================================================

local function safeDestroy(instance)
	-- Уничтожает Roblox-экземпляр через защищённый вызов.
	if instance == nil then
		return
	end

	pcall(function()
		instance:Destroy()
	end)
end

local function isAlive(instance)
	-- Проверяет, что Roblox-экземпляр всё ещё находится в дереве.
	if instance == nil then
		return false
	end

	local ok, parent = pcall(function()
		return instance.Parent
	end)

	return ok and parent ~= nil
end

local function setProperties(instance, properties)
	-- Устанавливает свойства экземпляра, пропуская недоступные свойства.
	if instance == nil or type(properties) ~= "table" then
		return instance
	end

	for propertyName, value in pairs(properties) do
		pcall(function()
			instance[propertyName] = value
		end)
	end

	return instance
end

local function create(className, properties, parent)
	-- Создаёт экземпляр, применяет свойства и назначает родителя.
	local ok, instance = pcall(function()
		return Instance.new(className)
	end)

	if not ok or not instance then
		return nil
	end

	setProperties(instance, properties)

	if parent then
		pcall(function()
			instance.Parent = parent
		end)
	end

	return instance
end

local function addCorner(parent, radius)
	-- Добавляет UICorner с указанным радиусом.
	local corner = create("UICorner", {
		CornerRadius = UDim.new(0, radius or DEFAULT_CORNER_RADIUS),
	}, parent)

	return corner
end

local function addStroke(parent, color, thickness, transparency)
	-- Добавляет чёрную или тематическую UIStroke.
	local stroke = create("UIStroke", {
		Color = color or Colors.Outline,
		Thickness = thickness or DEFAULT_STROKE_THICKNESS,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)

	return stroke
end

local function addGradient(parent, firstColor, secondColor, rotation)
	-- Добавляет UIGradient с металлическим цветовым переходом.
	local gradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, firstColor or Colors.Primary),
			ColorSequenceKeypoint.new(1, secondColor or Colors.Secondary),
		}),
		Rotation = rotation or 90,
	}, parent)

	return gradient
end

local function addPadding(parent, left, right, top, bottom)
	-- Добавляет UIPadding с явными отступами.
	local padding = create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
	}, parent)

	return padding
end

local function addListLayout(parent, padding, horizontal)
	-- Добавляет вертикальный или горизонтальный UIListLayout.
	local layout = create("UIListLayout", {
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding or 6),
	}, parent)

	return layout
end

--================================================================================
-- [004] СИГНАЛЫ И АНИМАЦИИ
--================================================================================

local function createSignal()
	-- Создаёт небольшой объект-сигнал с Connect, Fire и Disconnect.
	local listeners = {}
	local signal = {}

	function signal:Connect(callback)
		-- Подписывает функцию на пользовательский сигнал.
		if type(callback) ~= "function" then
			return nil
		end

		table.insert(listeners, callback)
		local disconnected = false
		local connection = {}

		function connection:Disconnect()
			-- Отключает одну подписку сигнала.
			if disconnected then
				return false
			end

			disconnected = true
			for index = #listeners, 1, -1 do
				if listeners[index] == callback then
					table.remove(listeners, index)
					return true
				end
			end

			return false
		end

		return connection
	end

	function signal:Fire(first, second, third, fourth, fifth)
		-- Вызывает все текущие обработчики сигнала.
		local snapshot = {}
		for index, callback in ipairs(listeners) do
			snapshot[index] = callback
		end

		for _, callback in ipairs(snapshot) do
			pcall(callback, first, second, third, fourth, fifth)
		end
	end

	function signal:Destroy()
		-- Очищает все обработчики сигнала.
		for index = #listeners, 1, -1 do
			listeners[index] = nil
		end
	end

	return signal
end

local function getAnimationTime()
	-- Возвращает длительность Tween-анимации из config.lua.
	local duration = setting("UI.AnimationDuration", DEFAULT_ANIMATION_TIME)
	if type(duration) ~= "number" then
		return DEFAULT_ANIMATION_TIME
	end

	return math.max(0.15, math.min(0.3, duration))
end

local function tween(instance, properties, duration, style, direction)
	-- Плавно меняет свойства экземпляра через TweenService.
	if not isAlive(instance) or not Services.TweenService then
		setProperties(instance, properties)
		return nil
	end

	local tweenInfo = TweenInfo.new(
		duration or getAnimationTime(),
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)

	local ok, animation = pcall(function()
		return Services.TweenService:Create(instance, tweenInfo, properties)
	end)

	if not ok or not animation then
		setProperties(instance, properties)
		return nil
	end

	animation:Play()
	return animation
end

local function connectSignal(signal, callback, connectionList)
	-- Подключает Roblox-сигнал и сохраняет соединение для очистки окна.
	if signal == nil or type(callback) ~= "function" then
		return nil
	end

	local ok, connection = pcall(function()
		return signal:Connect(callback)
	end)

	if ok and connection then
		table.insert(connectionList, connection)
		return connection
	end

	return nil
end

--================================================================================
-- [005] ТИПОГРАФИКА
--================================================================================

local function styleText(label, size, color, alignment)
	-- Применяет единый стиль текста к TextLabel или TextButton.
	setProperties(label, {
		Font = Enum.Font.Gotham,
		TextSize = size or 14,
		TextColor3 = color or Colors.Text,
		TextXAlignment = alignment or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false,
		BackgroundTransparency = 1,
	})

	return label
end

local function createTextLabel(parent, text, size, color)
	-- Создаёт стилизованный TextLabel.
	local label = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 24),
		Text = tostring(text or ""),
	}, parent)

	if label then
		styleText(label, size, color)
	end

	return label
end

local function createTextButton(parent, text, size, color)
	-- Создаёт стилизованную кнопку текста.
	local button = create("TextButton", {
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 34),
		Text = tostring(text or ""),
	}, parent)

	if button then
		styleText(button, size, color)
	end

	return button
end

--================================================================================
-- [006] СОЗДАНИЕ ROOT GUI
--================================================================================

local function getPlayerGui()
	-- Находит PlayerGui локального игрока без использования CoreGui.
	local player = Runtime.GetLocalPlayer()
	if not player then
		return nil
	end

	local ok, playerGui = pcall(function()
		return player:FindFirstChildOfClass("PlayerGui")
	end)

	if ok and playerGui then
		return playerGui
	end

	local waited, result = pcall(function()
		return player:WaitForChild("PlayerGui", 5)
	end)

	if waited then
		return result
	end

	return nil
end

local function createScreenGui(name)
	-- Создаёт ScreenGui в PlayerGui локального игрока.
	local playerGui = getPlayerGui()
	if not playerGui then
		return nil
	end

	local oldGui = playerGui:FindFirstChild(name)
	if oldGui then
		safeDestroy(oldGui)
	end

	local screenGui = create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)

	return screenGui
end

