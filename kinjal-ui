-- [001] CONFIG MODULE
--================================================================================
local Config = {}
local configData = {
	Trails = {
		Enabled = true,
		TagName = "BoykisserTrainingTarget",
		UpdateInterval = 0.2,
	},
	Tools = {
		ActivationDelay = 0.25,
		AllowedToolNames = { "TrainingTool", "Scanner", "Flashlight" },
	},
	Sound = {
		Enabled = true,
		MasterVolume = 1.0,
		MusicVolume = 0.35,
		EffectVolume = 0.70,
		AmbientVolume = 0.40,
		UIVolume = 0.60,
	},
}

function Config.Get(path, fallback)
	if type(path) ~= "string" then return fallback end
	local keys = {}
	for key in string.gmatch(path, "[^%.]+") do
		table.insert(keys, key)
	end
	local current = configData
	for _, key in ipairs(keys) do
		if type(current) == "table" and current[key] ~= nil then
			current = current[key]
		else
			return fallback
		end
	end
	return current
end

function Config.Set(path, value)
	if type(path) ~= "string" then return false end
	local keys = {}
	for key in string.gmatch(path, "[^%.]+") do
		table.insert(keys, key)
	end
	local current = configData
	for i = 1, #keys - 1 do
		local key = keys[i]
		if type(current[key]) ~= "table" then
			current[key] = {}
		end
		current = current[key]
	end
	current[keys[#keys]] = value
	return true
end

--================================================================================
-- [002] RUNTIME MODULE
--================================================================================
local Runtime = {}
local Roblox = game

local Services = {}
local function cacheService(serviceName)
	local ok, service = pcall(function() return Roblox:GetService(serviceName) end)
	if ok and service then
		Services[serviceName] = service
		return service
	end
	return nil
end

Services.Players = cacheService("Players")
Services.RunService = cacheService("RunService")
Services.UserInputService = cacheService("UserInputService")
Services.GuiService = cacheService("GuiService")
Services.TweenService = cacheService("TweenService")
Services.Lighting = cacheService("Lighting")
Services.SoundService = cacheService("SoundService")
Services.ReplicatedStorage = cacheService("ReplicatedStorage")
Services.Workspace = cacheService("Workspace")
Services.CollectionService = cacheService("CollectionService")

local sessionStartedAt = os.clock()
local cleanupTasks = {}
local eventConnections = {}
local destroyed = false

function Runtime.IsInstance(value)
	local ok, result = pcall(function() return typeof(value) == "Instance" end)
	return ok and result == true
end

function Runtime.IsA(value, className)
	if not Runtime.IsInstance(value) or type(className) ~= "string" then return false end
	local ok, result = pcall(function() return value:IsA(className) end)
	return ok and result == true
end

function Runtime.IsAlive(instance)
	if not Runtime.IsInstance(instance) then return false end
	local ok, parent = pcall(function() return instance.Parent end)
	return ok and parent ~= nil
end

function Runtime.IsStudio()
	local runService = Services.RunService
	if not runService then return false end
	local ok, result = pcall(function() return runService:IsStudio() end)
	return ok and result == true
end

function Runtime.IsClient()
	local runService = Services.RunService
	if not runService then return false end
	local ok, result = pcall(function() return runService:IsClient() end)
	return ok and result == true
end

function Runtime.IsServer()
	local runService = Services.RunService
	if not runService then return false end
	local ok, result = pcall(function() return runService:IsServer() end)
	return ok and result == true
end

function Runtime.GetLocalPlayer()
	local players = Services.Players
	if not players or not Runtime.IsClient() then return nil end
	local ok, player = pcall(function() return players.LocalPlayer end)
	return ok and player or nil
end

function Runtime.GetCharacter(player)
	if not Runtime.IsInstance(player) or not Runtime.IsA(player, "Player") then return nil end
	local ok, character = pcall(function() return player.Character end)
	return (ok and Runtime.IsAlive(character)) and character or nil
end

function Runtime.GetLocalCharacter()
	return Runtime.GetCharacter(Runtime.GetLocalPlayer())
end

--================================================================================
-- [003] SOUND MODULE
--================================================================================
local Sound = {}
local SoundManagers = {}

local CATEGORIES = { Music = true, Effects = true, Ambient = true, UI = true }

local function clamp(value, minimum, maximum, fallback)
	local number = tonumber(value) or fallback
	return math.max(minimum, math.min(maximum, number))
end

local function normalizeCategory(category)
	local text = tostring(category or "Effects")
	for name in pairs(CATEGORIES) do
		if string.lower(name) == string.lower(text) then return name end
	end
	return "Effects"
end

local function normalizeSoundId(soundId)
	local value = tostring(soundId or "")
	if value == "" then return "" end
	if string.find(value, "rbxassetid://", 1, true) then return value end
	if string.match(value, "^%d+$") then return "rbxassetid://" .. value end
	return value
end

function Sound.new(options)
	options = type(options) == "table" and options or {}
	if not Services.SoundService then return nil, "SoundService недоступен" end

	local manager = {
		SoundService = Services.SoundService,
		Sounds = {},
		Connections = {},
		Events = {},
		Enabled = options.Enabled ~= false and Config.Get("Sound.Enabled", true) == true,
		MasterVolume = clamp(options.MasterVolume or Config.Get("Sound.MasterVolume", 1), 0, 1, 1),
		MusicVolume = clamp(options.MusicVolume or Config.Get("Sound.MusicVolume", 0.35), 0, 1, 0.35),
		EffectVolume = clamp(options.EffectVolume or Config.Get("Sound.EffectVolume", 0.7), 0, 1, 0.7),
		AmbientVolume = clamp(options.AmbientVolume or Config.Get("Sound.AmbientVolume", 0.4), 0, 1, 0.4),
		UIVolume = clamp(options.UIVolume or Config.Get("Sound.UIVolume", 0.6), 0, 1, 0.6),
		Destroyed = false,
		Running = false,
	}

	function manager:Add(name, optionsData)
		if self.Destroyed then return nil, "Менеджер уничтожен" end
		local soundName = tostring(name or "BoykisserSound")
		if self.Sounds[soundName] then return self.Sounds[soundName] end

		optionsData = type(optionsData) == "table" and optionsData or {}
		local sound = Instance.new("Sound")
		sound.Name = "Boykisser_" .. soundName
		sound.SoundId = normalizeSoundId(optionsData.SoundId)
		sound.Looped = optionsData.Looped == true
		sound.PlaybackSpeed = clamp(optionsData.PlaybackSpeed or 1, 0.05, 4, 1)
		sound.Volume = 0
		sound.Parent = self.SoundService

		local entry = {
			Name = soundName,
			Instance = sound,
			Category = normalizeCategory(optionsData.Category),
			BaseVolume = clamp(optionsData.Volume or 1, 0, 1, 1),
			Connections = {},
		}
		self.Sounds[soundName] = entry
		return entry
	end

	function manager:Play(name)
		local entry = self.Sounds[tostring(name or "")]
		if not entry or not entry.Instance then return false end
		pcall(function()
			entry.Instance.Volume = entry.BaseVolume * manager.MasterVolume
			entry.Instance:Play()
		end)
		return true
	end

	function manager:Stop(name)
		local entry = self.Sounds[tostring(name or "")]
		if not entry or not entry.Instance then return false end
		pcall(function() entry.Instance:Stop() end)
		return true
	end

	table.insert(SoundManagers, manager)
	return manager
end

--================================================================================
-- [004] TOOLS MODULE
--================================================================================
local Tools = {}
local ToolManagers = {}

local DEFAULT_ALLOWED_NAMES = { "TrainingTool", "Scanner", "Flashlight" }

local function isLocalTool(tool)
	if not Runtime.IsA(tool, "Tool") then return false end
	local player = Runtime.GetLocalPlayer()
	if not player then return false end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	local parent = tool.Parent
	return parent == backpack or parent == character
end

function Tools.new(options)
	options = type(options) == "table" and options or {}
	local manager = {
		Inventory = {},
		AllowedNames = Config.Get("Tools.AllowedToolNames", DEFAULT_ALLOWED_NAMES),
		ActivationDelay = math.max(0.1, tonumber(options.ActivationDelay) or Config.Get("Tools.ActivationDelay", 0.25)),
		Running = false,
		Destroyed = false,
		LastActivation = 0,
	}

	function manager:Scan()
		if self.Destroyed then return 0 end
		local player = Runtime.GetLocalPlayer()
		if not player then return 0 end

		local count = 0
		local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
		for _, container in ipairs(containers) do
			if container then
				for _, child in ipairs(container:GetChildren()) do
					if Runtime.IsA(child, "Tool") then
						self.Inventory[child] = { Tool = child, Name = child.Name }
						count = count + 1
					end
				end
			end
		end
		return count
	end

	function manager:Equip(tool)
		local target = type(tool) == "table" and tool.Tool or tool
		if not isLocalTool(target) then return false end
		local character = Runtime.GetLocalCharacter()
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			pcall(function() humanoid:EquipTool(target) end)
			return true
		end
		return false
	end

	table.insert(ToolManagers, manager)
	return manager
end

--================================================================================
-- [005] TRAILS MODULE
--================================================================================
local Trails = {}
local TrailManagers = {}

local PRESETS = {
	pink = {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 235, 250)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(191, 65, 153)),
		}),
		Lifetime = 0.55,
	},
	rainbow = {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 105, 149)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(121, 239, 156)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(244, 122, 220)),
		}),
		Lifetime = 0.7,
	},
}

function Trails.new(options)
	options = type(options) == "table" and options or {}
	local manager = {
		Entries = {},
		Enabled = options.Enabled ~= false,
		TagName = tostring(options.TagName or Config.Get("Trails.TagName", "BoykisserTrainingTarget")),
		Running = false,
		Destroyed = false,
	}

	function manager:Add(target, optionsData)
		if self.Destroyed or not Runtime.IsAlive(target) then return nil end
		local root = target:IsA("BasePart") and target or (target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)))
		if not root then return nil end

		optionsData = type(optionsData) == "table" and optionsData or {}
		local firstAttachment = Instance.new("Attachment")
		firstAttachment.Name = "BoykisserTrailAttachmentA"
		firstAttachment.Position = Vector3.new(0, 1.2, 0)
		firstAttachment.Parent = root

		local secondAttachment = Instance.new("Attachment")
		secondAttachment.Name = "BoykisserTrailAttachmentB"
		secondAttachment.Position = Vector3.new(0, -1.2, 0)
		secondAttachment.Parent = root

		local trail = Instance.new("Trail")
		trail.Name = "BoykisserTrainingTrail"
		trail.Attachment0 = firstAttachment
		trail.Attachment1 = secondAttachment
		trail.Color = PRESETS.pink.Color
		trail.Lifetime = PRESETS.pink.Lifetime
		trail.Parent = root

		local entry = { Target = target, Trail = trail }
		self.Entries[target] = entry
		return entry
	end

	table.insert(TrailManagers, manager)
	return manager
end

