function UI.AddSlider(tab, title, minimum, maximum, defaultValue, callback, options)
	-- Добавляет числовой ползунок с touch и мышью.
	if not tab or not isAlive(tab.Page) then
		return nil
	end

	options = type(options) == "table" and options or {}
	minimum = tonumber(minimum) or 0
	maximum = tonumber(maximum) or 100
	if maximum <= minimum then
		maximum = minimum + 1
	end

	local holder = create("Frame", {
		Name = tostring(options.Name or "Slider"),
		Size = UDim2.new(1, 0, 0, options.Height or 60),
		BackgroundColor3 = Colors.Panel,
		BorderSizePixel = 0,
	}, tab.Page)
	addCorner(holder, 8)
	addStroke(holder, Colors.Outline, 1)

	local label = createTextLabel(holder, tostring(title or "Slider"), 13, Colors.Text)
	label.Position = UDim2.new(0, 12, 0, 4)
	label.Size = UDim2.new(0.7, 0, 0, 22)

	local valueLabel = createTextLabel(holder, "", 12, Colors.Secondary)
	valueLabel.Position = UDim2.new(0.7, -12, 0, 4)
	valueLabel.Size = UDim2.new(0.3, 0, 0, 22)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local bar = create("Frame", {
		Name = "Bar",
		Position = UDim2.new(0, 12, 0, 36),
		Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
	}, holder)
	addCorner(bar, 4)

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Colors.Primary,
		BorderSizePixel = 0,
	}, bar)
	addCorner(fill, 4)
	addGradient(fill, Colors.Primary, Colors.Secondary, 0)

	local control = {
		Instance = holder,
		Value = tonumber(defaultValue) or minimum,
		Minimum = minimum,
		Maximum = maximum,
		Changed = createSignal(),
	}

	local function quantize(value)
		-- Ограничивает и округляет значение ползунка.
		local step = tonumber(options.Step) or 1
		local bounded = math.max(minimum, math.min(maximum, value))
		return math.floor((bounded - minimum) / step + 0.5) * step + minimum
	end

	local function render()
		-- Отрисовывает положение заполнения и числовую подпись.
		local ratio = (control.Value - minimum) / (maximum - minimum)
		ratio = math.max(0, math.min(1, ratio))
		tween(fill, {Size = UDim2.new(ratio, 0, 1, 0)}, getAnimationTime())
		valueLabel.Text = string.format("%g", control.Value)
	end

	function control:Set(value, silent)
		-- Устанавливает число и вызывает callback при изменении.
		control.Value = quantize(tonumber(value) or minimum)
		render()

		if not silent then
			if type(callback) == "function" then
				pcall(callback, control.Value, control)
			end
			control.Changed:Fire(control.Value)
		end

		return control.Value
	end

	function control:Get()
		-- Возвращает текущее значение ползунка.
		return control.Value
	end

	local draggingSlider = false

	local function updateFromInput(inputX)
		-- Пересчитывает число по горизонтальной координате указателя.
		local absolutePosition = bar.AbsolutePosition.X
		local absoluteSize = math.max(1, bar.AbsoluteSize.X)
		local ratio = math.max(0, math.min(1, (inputX - absolutePosition) / absoluteSize))
		control:Set(minimum + (maximum - minimum) * ratio)
	end

	connectSignal(bar.InputBegan, function(input)
		-- Начинает изменение ползунка мышью или touch.
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			draggingSlider = true
			updateFromInput(input.Position.X)
		end
	end, tab.Window.Connections)

	connectSignal(bar.InputEnded, function(input)
		-- Завершает изменение ползунка.
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end, tab.Window.Connections)

	connectSignal(Services.UserInputService and Services.UserInputService.InputChanged, function(input)
		-- Обновляет ползунок во время перемещения указателя.
		if not draggingSlider then
			return
		end

		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch then
			updateFromInput(input.Position.X)
		end
	end, tab.Window.Connections)

	function control:Destroy()
		-- Уничтожает ползунок.
		self.Changed:Destroy()
		safeDestroy(holder)
	end

	control:Set(control.Value, true)
	table.insert(tab.Controls, control)
	return control
end

function UI.AddDropdown(tab, title, optionsList, defaultValue, callback, options)
	-- Добавляет выпадающий список значений.
	if not tab or not isAlive(tab.Page) then
		return nil
	end

	options = type(options) == "table" and options or {}
	optionsList = type(optionsList) == "table" and optionsList or {}

	local holder = create("Frame", {
		Name = tostring(options.Name or "Dropdown"),
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Colors.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, tab.Page)
	addCorner(holder, 8)
	addStroke(holder, Colors.Outline, 1)

	local button = createTextButton(holder, "", 13, Colors.Text)
	button.Position = UDim2.new(0, 8, 0, 4)
	button.Size = UDim2.new(1, -16, 0, 34)
	button.TextXAlignment = Enum.TextXAlignment.Left
	addPadding(button, 8, 8, 0, 0)
	addCorner(button, 7)

	local menu = create("Frame", {
		Name = "Menu",
		Position = UDim2.new(0, 8, 0, 43),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundColor3 = Colors.Background,
		BorderSizePixel = 0,
		Visible = false,
	}, holder)
	addCorner(menu, 7)
	addStroke(menu, Colors.Outline, 1)
	local menuLayout = addListLayout(menu, 2, false)
	addPadding(menu, 4, 4, 4, 4)

	local control = {
		Instance = holder,
		Value = defaultValue,
		Options = optionsList,
		Open = false,
		Changed = createSignal(),
	}

	local function updateText()
		-- Обновляет подпись выбранного элемента.
		button.Text = tostring(title or "Select") .. ": " .. tostring(control.Value or "None")
	end

	local function closeMenu()
		-- Закрывает список значений.
		control.Open = false
		menu.Visible = false
		holder.Size = UDim2.new(1, 0, 0, 42)
	end

	local function choose(value)
		-- Выбирает значение и уведомляет callback.
		control.Value = value
		updateText()
		closeMenu()

		if type(callback) == "function" then
			pcall(callback, value, control)
		end
		control.Changed:Fire(value)
	end

	for index, value in ipairs(optionsList) do
		local optionButton = createTextButton(menu, tostring(value), 12, Colors.MutedText)
		optionButton.Name = "Option_" .. tostring(index)
		optionButton.Size = UDim2.new(1, 0, 0, 28)
		optionButton.LayoutOrder = index
		addCorner(optionButton, 5)

		connectSignal(optionButton.Activated, function()
			-- Выбирает пункт меню при клике или touch.
			choose(value)
		end, tab.Window.Connections)
	end

	connectSignal(button.Activated, function()
		-- Открывает или закрывает меню выбора.
		control.Open = not control.Open
		menu.Visible = control.Open

		if control.Open then
			local height = math.min(160, #optionsList * 30 + 10)
			holder.Size = UDim2.new(1, 0, 0, 48 + height)
			menu.Size = UDim2.new(1, -16, 0, height)
		else
			closeMenu()
		end
	end, tab.Window.Connections)

	function control:Set(value, silent)
		-- Устанавливает выбранное значение из списка.
		local valid = false
		for _, option in ipairs(optionsList) do
			if option == value then
				valid = true
				break
			end
		end

		if valid then
			control.Value = value
			updateText()
			if not silent then
				if type(callback) == "function" then
					pcall(callback, value, control)
				end
				control.Changed:Fire(value)
			end
		end

		return control.Value
	end

	function control:Get()
		-- Возвращает выбранный элемент списка.
		return control.Value
	end

	function control:Destroy()
		-- Уничтожает выпадающий список.
		self.Changed:Destroy()
		safeDestroy(holder)
	end

	updateText()
	table.insert(tab.Controls, control)
	return control
end

function UI.AddSpacer(tab, height)
	-- Добавляет пустой вертикальный отступ на вкладку.
	if not tab or not isAlive(tab.Page) then
		return nil
	end

	local spacer = create("Frame", {
		Name = "Spacer",
		Size = UDim2.new(1, 0, 0, tonumber(height) or 8),
		BackgroundTransparency = 1,
	}, tab.Page)

	table.insert(tab.Controls, spacer)
	return spacer
end

